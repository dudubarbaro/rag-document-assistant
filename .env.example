# Provedor: offline (sem chave, só para demo) | gemini (plano gratuito) | openai | azure
LLM_PROVIDER=offline

# --- Google Gemini (gratuito, sem cartão: crie a chave em https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_REASONING_EFFORT=low

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Opcional: outra API compatível com a da OpenAI (o modelo de embeddings precisa existir lá)
# OPENAI_BASE_URL=https://...

# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=https://SEU-RECURSO.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# --- Banco vetorial ---
# No Docker Compose a API já recebe DATABASE_URL apontando para o serviço "db".
# Para rodar o backend FORA do Docker (uvicorn local), descomente a linha abaixo.
# Se ficar vazio, o backend usa um banco vetorial em memória (perde tudo ao reiniciar).
# DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag

# --- Parâmetros do RAG ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=4
# Abaixo deste score (0..1) o trecho é descartado. Padrão: 0.30 (openai/azure) ou 0.10 (offline)
# MIN_RELEVANCE=0.30

# Mostra no terminal o prompt completo enviado ao LLM e a resposta (para estudo/debug)
DEBUG_LLM=false
