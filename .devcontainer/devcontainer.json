{
  "name": "RAG Document Assistant",
  // Imagem padrão do GitHub Codespaces: já vem com Docker, Python e Node,
  // sem nada para instalar durante o build (sobe mais rápido e com menos risco de falha).
  "image": "mcr.microsoft.com/devcontainers/universal:6",
  "forwardPorts": [5173, 8000],
  "portsAttributes": {
    "5173": { "label": "Interface (React)" },
    "8000": { "label": "API (FastAPI)" }
  },
  "postCreateCommand": "cp -n .env.example .env; pip install -r backend/requirements-dev.txt; cd frontend && npm ci",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.debugpy",
        "charliermarsh.ruff",
        "bierner.markdown-mermaid",
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}
