{
  "name": "RAG Document Assistant",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [5173, 8000],
  "portsAttributes": {
    "5173": { "label": "Interface (React)" },
    "8000": { "label": "API (FastAPI)" }
  },
  "postCreateCommand": "cp -n .env.example .env; pip install -r backend/requirements-dev.txt && cd frontend && npm ci",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.debugpy",
        "charliermarsh.ruff",
        "bierner.markdown-mermaid",
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}
